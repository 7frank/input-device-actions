{
  "name": "@nk11/keyboard-interactions",
  "version": "2.0.0",
  "description": "A wrapper for mousetrap and other human interface libraries with additional actions to be able to change hotkeys for actions via dialog.",
  "author": "Frank Reimann (https://github.com/frank1147)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:app": "vite build",
    "analyze": "tsup --metafile && npx esbuild-visualizer --metadata dist/core/metafile-cjs.json --filename stats-core-cjs.html --open && npx esbuild-visualizer --metadata dist/core/metafile-esm.json --filename stats-core-esm.html --open && npx esbuild-visualizer --metadata dist/ui/metafile-esm.json --filename stats-ui-esm.html --open",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write ."
  },
  "exports": {
    ".": "./dist/core/index.mjs",
    "./ui": "./dist/ui/index.mjs",
    "./ui/index.css": "./dist/ui/index.css"
  },
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.mjs",
  "license": "MIT",
  "keywords": [
    "keymap",
    "mousetrap",
    "hotkeys"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "esbuild-svelte": "^0.8.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "svelte": "^4.0.0",
    "svelte-check": "^3.0.0",
    "svelte-preprocess": "^5.0.0",
    "tslib": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "humaninput": "^1.1.15",
    "key-event-to-string": "^1.2.0",
    "keypress.js": "^2.1.5",
    "lodash": "^4.17.21",
    "mousetrap": "^1.6.5",
    "mutation-summary": "^1.0.0",
    "sveltestrap": "^5.6.3",
    "tiny-emitter": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/7frank/input-device-actions.git"
  }
}
