{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "vite.config.js"],
  "exclude": ["node_modules/*", "public/*"]
}
